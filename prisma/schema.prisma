datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Stream {
  EXPERIMENTAL_SCIENCES
}
enum Subject {
  ISLAMIC_SCIENCES
  HISTORY_GEOGRAPHY
  PHILOSOPHY
  ARABIC_LITERATURE
}
enum ExamSession {
  REGULAR
  EXCEPTIONAL
}
enum QuestionType {
  DEFINITION
  CHRONOLOGY
  PERSONALITY
  MAP_SIGNING
  TABLE_COMMENTARY
  RULING_AND_BENEFIT
  ESSAY_PHILOSOPHICAL
  ESSAY_HISTORICAL_GEOGRAPHICAL
  TEXT_SUMMARIZATION
  SYNTAX_RHETORIC
}

model BacExam {
  id                  String       @id @default(cuid())
  year                Int
  session             ExamSession  @default(REGULAR)
  stream              Stream       @default(EXPERIMENTAL_SCIENCES)
  subject             Subject
  topicNumber         Int
  pdfUrl              String
  hasOfficialSolution Boolean      @default(true)
  createdAt           DateTime     @default(now())
  questions           Question[]
  @@unique([year, session, subject, topicNumber])
}

model Question {
  id              String       @id @default(cuid())
  examId          String
  exam            BacExam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  order           Int
  part            Int
  type            QuestionType
  promptText      String       @db.Text
  totalPoints     Float
  embedding       Unsupported("vector(1536)")?
  rubricItems     RubricItem[]
  studentAnswers  StudentSubmission[]
}

model RubricItem {
  id              String    @id @default(cuid())
  questionId      String
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  criterion       String
  indicator       String    @db.Text
  pointsAllocated Float
  keywords        String[]
  deductionRule   String?
}

model StudentSubmission {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submittedAnswer String   @db.Text
  awardedScore    Float
  feedbackJson    Json
  createdAt       DateTime @default(now())
}

model FSRSFlashcard {
  id              String    @id @default(cuid())
  userId          String
  subject         Subject
  category        String
  frontPrompt     String    @db.Text
  backAnswer      String    @db.Text
  pedagogicalTips String?   @db.Text
  stability       Float     @default(0)
  difficulty      Float     @default(0)
  elapsedDays     Int       @default(0)
  scheduledDays   Int       @default(0)
  reps            Int       @default(0)
  state           Int       @default(0)
  lastReview      DateTime?
  nextDue         DateTime  @default(now())
}

model RevisionPlan {
  id              String   @id @default(cuid())
  userId          String   @unique
  startDate       DateTime @default(now())
  bacTargetDate   DateTime
  dailyStudyTime  Int
  masteryMatrix   Json
  updatedAt       DateTime @updatedAt
}
